# Copy to .env and fill in what you need. Every value is optional:
# the server starts without them and switches the matching feature off.
PORT=3000
MONGODB_URI=                     # MongoDB connection string (accounts, ranks, history)
NEAR_NETWORK=testnet

# Admin dashboard (/admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email login codes (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Pool escrow contract v4 (testnet)
POOL_CONTRACT_ACCOUNT_ID=near_saboteur_contract.testnet
ORACLE_ACCOUNT_ID=
ORACLE_PRIVATE_KEY=              # server-side only, never commit

# $SABOTEUR v2 token (testnet)
SABOTEUR_PARENT_ACCOUNT_ID=      # e.g. saboteur.testnet (game reporter = rewards.<parent>)
SABOTEUR_PARENT_PRIVATE_KEY=     # server-side only, never commit
SABOTEUR_TOKEN_ID=               # default sabo.<parent>

# Weekly Rewards Agent (NEAR Intents, mainnet)
NEAR_INTENTS_AGENT_API_KEY=
WEEKLY_AGENT_SECRET=             # encrypts the agent grant token in MongoDB
WEEKLY_EXCLUDE=om7eth            # founder / test accounts that can't win

# Play Pass + custom characters (mainnet NEAR)
PLAY_PASS_MAINNET_RECEIVER=saboteur.near

# NEAR AI (bots talk in meetings, NEAR AI mission)
NEAR_AI_API_KEY=

# Telegram bot (off unless TELEGRAM_PAUSED=0)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PAUSED=1

# Public URLs
FRONTEND_PUBLIC_URL=https://nearsaboteur.com
BACKEND_PUBLIC_URL=
